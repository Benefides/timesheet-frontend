# Where the backend API lives
VITE_API_BASE=http://localhost:4000/api/v1

# 'dev'  -> log in by picking a seeded user (no Azure needed)
# 'entra'-> real Microsoft sign-in (requires the values below)
VITE_AUTH_MODE=dev

# Only needed when VITE_AUTH_MODE=entra
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://YOUR_API_CLIENT_ID/access_as_user
